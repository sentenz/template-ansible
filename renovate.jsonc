{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "1 day",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/bower_components/**",
    "**/charts/**",
    "test/**",
    "tests/**"
  ],
  "nuget": {
    "ignorePaths": [
      "tests/**",
      "**/tests/**"
    ]
  },
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "automerge": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Docker image references in Makefiles and Ansible inventory group variables.",
      "managerFilePatterns": [
        "**/[Mm]akefile",
        "**/GNUMakefile",
        "**/*.mk",
        "inventory/**/group_vars/**/*.yml"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "(?<depName>(?:(?:[A-Za-z0-9.-]+(?::[0-9]+)?/)?[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)):(?<currentValue>[A-Za-z0-9_][0-9A-Za-z_.-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "autoReplaceStringTemplate": "{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{else}}{{#if currentDigest}}@{{{currentDigest}}}{{/if}}{{/if}}",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Pin Dockerfile and Containerfile images to immutable digests.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Pin Docker images used by GitHub Actions to immutable digests.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "docker",
        "container",
        "service"
      ],
      "pinDigests": true,
      "automerge": true
    },
    {
      "description": "Group Docker image updates used by GitHub Actions.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "docker",
        "container",
        "service"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "github actions container images",
      "groupSlug": "github-actions-container-images",
      "semanticCommits": "enabled",
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps",
      "automerge": true
    },
    {
      "description": "Group Dockerfile and Containerfile image updates.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "digest"
      ],
      "pinDigests": true,
      "groupName": "dockerfile container images",
      "groupSlug": "dockerfile-container-images",
      "automerge": false
    },
    {
      "description": "Pin custom-manager Docker images to immutable digests.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Group and pin Docker image updates in Makefiles.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "**/[Mm]akefile",
        "**/GNUMakefile",
        "**/*.mk"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "digest"
      ],
      "pinDigests": true,
      "groupName": "makefile container images",
      "groupSlug": "makefile-container-images",
      "semanticCommits": "enabled",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "automerge": true
    },
    {
      "description": "Group and pin Docker image updates in Ansible inventory group variables.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "inventory/**/group_vars/**/*.yml"
      ],
      "pinDigests": true,
      "groupName": "inventory container images",
      "groupSlug": "inventory-container-images",
      "semanticCommits": "enabled",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "automerge": false
    },
    {
      "description": "Group Ansible Galaxy dependency updates from requirements files.",
      "matchManagers": [
        "ansible-galaxy"
      ],
      "matchFileNames": [
        "**/requirements.yml",
        "**/requirements.ansible.yml",
        "**/galaxy.yml"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "digest"
      ],
      "pinDigests": true,
      "groupName": "ansible dependencies",
      "groupSlug": "ansible-dependencies",
      "semanticCommits": "enabled",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "automerge": false
    }
  ]
}
